{
  "version": 7,
  "project": "BowserAI/Nessy",
  "discovery": {
    "strategy": "embedded-first",
    "configuration": "repository",
    "manual_endpoint_required": false,
    "embedded_manifest_fallback": true,
    "failover": "remote-first-with-browser-inference-fallback",
    "manifest_timeout_ms": 6000,
    "runtime_timeout_ms": 8000
  },
  "runtimes": [
    {
      "name": "kairos",
      "base": "https://the-real-kairos.com",
      "chat_paths": ["/v1/chat/completions", "/api/v1/chat/completions", "/api/chat", "/chat/api", "/chat", "/v1/chat"],
      "method": "POST",
      "priority": 100,
      "format": "openai"
    },
    {
      "name": "pollinations",
      "base": "https://gen.pollinations.ai",
      "chat_paths": ["/v1/chat/completions"],
      "method": "POST",
      "priority": 70,
      "format": "openai"
    }
  ],
  "browser": {
    "engine": "transformers-js",
    "models": [
      {"name": "SmolLM2-1.7B-Instruct", "model": "HuggingFaceTB/SmolLM2-1.7B-Instruct", "dtype": "q4", "priority": 100},
      {"name": "SmolLM2-360M-Instruct", "model": "HuggingFaceTB/SmolLM2-360M-Instruct", "dtype": "q4", "priority": 80},
      {"name": "SmolLM2-135M-Instruct", "model": "HuggingFaceTB/SmolLM2-135M-Instruct", "dtype": "q4", "priority": 60}
    ],
    "cdn": "https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.8.1"
  },
  "capabilities": ["reasoning", "planning", "memory", "research", "tools", "coding", "multimodal", "self_evaluation", "capability_routing", "continuous_learning"],
  "session": {
    "client_persistence": "indexeddb",
    "server_session": true,
    "clear_policy": "user-initiated"
  }
}
