{
  "version": 5,
  "project": "BowserAI/Nessy",
  "discovery": {
    "strategy": "embedded-first",
    "configuration": "repository",
    "manual_endpoint_required": false,
    "embedded_manifest_fallback": true,
    "failover": "remote-priority-then-browser-inference",
    "manifest_timeout_ms": 8000,
    "runtime_timeout_ms": 12000
  },
  "runtimes": [
    {
      "name": "kairos",
      "base": "https://the-real-kairos.com",
      "chat_paths": ["/api/chat", "/chat/api", "/api/v1/chat", "/v1/chat"],
      "method": "POST",
      "priority": 100
    },
    {
      "name": "pollinations",
      "base": "https://gen.pollinations.ai",
      "chat_paths": ["/v1/chat/completions"],
      "method": "POST",
      "priority": 70
    }
  ],
  "browser": {
    "engine": "webllm",
    "model": "Llama-3.2-1B-Instruct-q4f16_1-MLC",
    "priority": 10,
    "webgpu_required": true,
    "cdn": "https://esm.run/@mlc-ai/web-llm"
  },
  "capabilities": ["reasoning", "planning", "memory", "research", "tools", "coding", "multimodal", "self_evaluation", "capability_routing", "continuous_learning"],
  "session": {
    "client_persistence": "sessionStorage",
    "server_session": true
  }
}
