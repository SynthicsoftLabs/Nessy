{
  "version": 3,
  "project": "BowserAI/Nessy",
  "discovery": {
    "strategy": "automatic",
    "configuration": "repository",
    "manual_endpoint_required": false,
    "embedded_manifest_fallback": true,
    "failover": "priority_then_fallback",
    "health": "request_probe"
  },
  "runtimes": [
    {
      "name": "kairos",
      "base": "https://the-real-kairos.com",
      "chat_paths": ["/api/chat", "/chat/api", "/api/v1/chat", "/v1/chat"],
      "method": "POST",
      "priority": 100
    },
    {
      "name": "pollinations",
      "base": "https://text.pollinations.ai",
      "chat_paths": ["/"],
      "method": "GET",
      "priority": 50
    }
  ],
  "capabilities": [
    "reasoning",
    "planning",
    "memory",
    "research",
    "tools",
    "coding",
    "multimodal",
    "self_evaluation",
    "capability_routing",
    "continuous_learning"
  ],
  "session": {
    "client_persistence": "sessionStorage",
    "server_session": true
  }
}
